# Native and downloaded binaries
*.elf
*.bin
*.o
# The vendored etaHEN is a repo asset, not a build output: no public release
# exists to download it from, so the default chain builds from this copy.
!payloads/default/*.elf

# Generated installer registry, version and metadata
include/file_registry.h
include/file_registry.c
include/.file_registry.stamp
include/wampi_version.h
assets/param.json
assets/icon0.png
assets/icon.ico
frontend/installer-page/logo.svg
frontend/dist/

# Build inputs, standalone HTML, host and packaging outputs
build/
dist/
wamphyre-autoloader-host.py
wamphyre-autoloader-host_v*.py
wamphyre-autoloader-host.exe
wamphyre-autoloader-host_v*.exe
wamphyre-autoloader-host.spec

# Generated embed arrays and staged default-chain payloads (built by
# payload-deps / make autoload-elf, never edited by hand)
third_party/ps5-unified-autoloader/payloads/
third_party/ps5-unified-autoloader/*_elf.c
third_party/ps5-unified-autoloader/etahen_config.c

# The vendored PS5 payload SDK: binary distribution wrapped around the host
# LLVM, brought in by tools/install_sdk.sh (pinned v0.44, sha256-verified)
# and completed by tools/build_sdk_deps.sh. Content is never committed; the
# scripts that fetch and complete it are.
tools/ps5-payload-sdk/

# OS / Python / logs / local references
.DS_Store
Thumbs.db
__pycache__/
*.pyc
*.log
.for_reference/

# Local research material — never published: kernel dumps are derived from
# Sony's proprietary firmware and the dump repositories carry no license.
# RESEARCH/verify-offsets.js is kept here too; copy it out explicitly if it
# should ever be published.
RESEARCH/
